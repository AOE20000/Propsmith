# Godot 4+ specific ignores
.godot/
/android/

# Terrain3D's GDExtension is `reloadable`, so the engine copies its library to a
# `~`-prefixed name beside the real one at load time. The copy is regenerated on
# every run (and vanishes in between, which is why it kept showing up as a stray
# untracked file), so it must never be tracked.
addons/terrain_3d/bin/~*

# Agent workspace state (memory notes, caches) — not project source
.workbuddy/
# PLATEAU multi-city scan output (downloaded datasets and coverage reports)
tools/plateau/.scan/

# PLATEAU city data (hundreds of MB per city) - downloaded via tools/plateau/scan_cities.py
data/

# PLATEAU GDExtension reloadable copies (same mechanism as terrain_3d had)
addons/plateau/**/~*

# Local-only development references (playtest notes against commercial titles)
docs/local/

# Vendored toolchain (Blender portable, MB-Lab / VRM addon copies, installer
# zips) — hundreds of MB of third-party binaries kept out of the repository but
# on the same drive, so the toolchain survives a disk cleanup while git stays
# lean. Rebuilt by tools/hamr/run.ps1 and docs/local/hamr.md.
vendor/
